BEGIN
    main.gb_robust.show
    main.tx_alty.show
    main.vl_alty.show
    main.tx_altx.show
    main.vl_altx.show
    main.tx_addcontrols.show
    main.vl_addcontrols.show
    main.tx_addfe.show
    main.vl_addfe.show
    main.tx_lags.show
    main.ed_lags.show
    main.tx_leads.show
    main.ed_leads.show
    main.tx_subsample.show
    main.ed_subsample.show
    main.tx_robust_note.show
    main.gb_endog.show
    main.tx_endog.show
    main.vl_endog.show
    main.tx_instruments.show
    main.vl_instruments.show
    main.tx_endog_note.show
    main.gb_mech.show
    main.tx_mediators.show
    main.vl_mediators.show
    main.tx_moderators.show
    main.vl_moderators.show
    main.tx_mech_note.show
