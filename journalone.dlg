    VARNAME vn_panel2 105 @ 160 .
    TEXT tx_time2 285 @ 75 ., label("时间变量：")
    VARNAME vn_time2 365 @ 160 ., numeric
    TEXT tx_cluster2 545 @ 85 ., label("聚类变量：")
    EDIT vn_cluster2 635 @ 150 ., tooltip("可填写单个聚类变量；HDFE模型也可填写交互聚类，如 group_id#time_id")
    CHECKBOX ck_timefe2 805 @ 170 ., label("加入时间固定效应") default(0)
    TEXT tx_note2 815 @ 160 ., label("")

    GROUPBOX gb3 30 325 960 126, label("模型 3")
    BUTTON bu_collapse3 920 212 55 ., label("折叠") onpush(program baseline_fold_all_dispatch)
    BUTTON bu_expand3 920 210 55 ., label("展开") onpush(program baseline_render_model3)
    TEXT tx_collapsed3 180 425 650 ., label("已折叠；内容保留并参与运行。")
    TEXT tx_model3 45 348 85 ., label("模型类型：")
    COMBOBOX cb_model3 135 @ 210 ., dropdownlist contents(model_list)
