PROGRAM baseline_visibility_dispatch
BEGIN
    if baseline_model_count.iseq(1) {
        call main.gb_base_editor.setposition 15 20 990 180
    }
    else {
        if baseline_model_count.iseq(2) {
            call main.gb_base_editor.setposition 15 20 990 310
        }
        else {
            if baseline_model_count.iseq(3) {
                call main.gb_base_editor.setposition 15 20 990 440
            }
            else {
                if baseline_model_count.iseq(4) {
                    call main.gb_base_editor.setposition 15 20 990 570
                }
                else {
                    if baseline_model_count.iseq(5) {
                        call main.gb_base_editor.setposition 15 20 990 700
                    }
                    else {
                        call main.gb_base_editor.setposition 15 20 990 830
                    }
                }
            }
        }
    }
    call script baseline_model1_hide
    call script baseline_model2_hide
    call script baseline_model3_hide
    call script baseline_model4_hide
    call script baseline_model5_hide
    call script baseline_model6_hide
    if baseline_model_count.iseq(1) {
        call script baseline_model1_expand
    }
    else {
        if baseline_model_count.iseq(2) {
            call script baseline_model1_expand
            call script baseline_model2_expand
        }
        else {
            if baseline_model_count.iseq(3) {
                call script baseline_model1_expand
                call script baseline_model2_expand
                call script baseline_model3_expand
            }
            else {
                call script baseline_model1_expand
                call script baseline_model2_expand
                call script baseline_model3_expand
                call script baseline_model4_expand
                if baseline_model_count.iseq(5) {
                    call script baseline_model5_expand
                }
                if baseline_model_count.iseq(6) {
                    call script baseline_model5_expand
                    call script baseline_model6_expand
                }
            }
        }
    }
END

/* Render routines use PROGRAM calls so all hide/show operations finish in
   order.  This avoids the asynchronous nested-SCRIPT overlap that can make
   two model cards appear expanded at the same time. */
PROGRAM baseline_fold_all_dispatch
BEGIN
    call script baseline_model1_collapse
    call script baseline_model2_collapse
    call script baseline_model3_collapse
    call script baseline_model4_collapse
    call script baseline_model5_collapse
    call script baseline_model6_collapse
    call script baseline_layout_all_collapsed
    call program baseline_visibility_dispatch
END

PROGRAM baseline_render_model1
BEGIN
    call script baseline_model1_collapse
    call script baseline_model2_collapse
    call script baseline_model3_collapse
    call script baseline_model4_collapse
    call script baseline_model5_collapse
    call script baseline_model6_collapse
    call script baseline_layout_all_collapsed
    call program baseline_visibility_dispatch
    call script baseline_layout_model1
    call script baseline_model1_expand
END

