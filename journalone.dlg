            put " indepvars3(" /hidden main.vl_x3 ")"
        }
        if main.vl_controls3.isneq("") {
            put " controls3(" /hidden main.vl_controls3 ")"
        }
        if main.vn_panel3.isneq("") {
            put " panel3(" /hidden main.vn_panel3 ")"
        }
        if main.vn_time3.isneq("") {
            put " time3(" /hidden main.vn_time3 ")"
        }
        if main.vl_absorb3.isneq("") {
            put " absorb3(" /hidden main.vl_absorb3 ")"
        }
        if main.ck_timefe3 & main.vn_time3.isneq("") {
            put " timefe3"
        }
        if main.ed_if3.isneq("") {
            put " ifcond3(" /hidden main.ed_if3 ")"
        }
        put " vcetype3("
        if main.cb_vce3.iseq("常规标准误") {
            put "conventional"
        }
        if main.cb_vce3.iseq("异方差稳健") {
            put "robust"
        }
        if main.cb_vce3.iseq("聚类稳健") {
            put "cluster"
        }
        put ")"
        if main.vn_cluster3.isneq("") {
            put " cluster3(" /hidden main.vn_cluster3 ")"
        }
    }
END

PROGRAM baseline_model4_output
BEGIN
    if main.vn_y4.isneq("") {
        put "model4("
        if main.cb_model4.iseq("普通最小二乘 OLS") {
            put "ols"
        }
        if main.cb_model4.iseq("高维固定效应 HDFE") {
            put "hdfe"
        }
        if main.cb_model4.iseq("面板固定效应 FE") {
            put "fe"
        }
        if main.cb_model4.iseq("面板随机效应 RE") {
            put "re"
        }
        if main.cb_model4.iseq("简单双重差分 DID") {
            put "did"
        }
        if main.cb_model4.iseq("两阶段最小二乘 IV") {
            put "iv"
        }
        put ") depvar4(" /hidden main.vn_y4 ")"
        if main.vl_x4.isneq("") {
            put " indepvars4(" /hidden main.vl_x4 ")"
        }
        if main.vl_controls4.isneq("") {
            put " controls4(" /hidden main.vl_controls4 ")"
        }
        if main.vn_panel4.isneq("") {
            put " panel4(" /hidden main.vn_panel4 ")"
        }
        if main.vn_time4.isneq("") {
            put " time4(" /hidden main.vn_time4 ")"
        }
        if main.vl_absorb4.isneq("") {
            put " absorb4(" /hidden main.vl_absorb4 ")"
        }
        if main.ck_timefe4 & main.vn_time4.isneq("") {
            put " timefe4"
        }
        if main.ed_if4.isneq("") {
            put " ifcond4(" /hidden main.ed_if4 ")"
        }
        put " vcetype4("
        if main.cb_vce4.iseq("常规标准误") {
            put "conventional"
        }
        if main.cb_vce4.iseq("异方差稳健") {
            put "robust"
        }
        if main.cb_vce4.iseq("聚类稳健") {
            put "cluster"
        }
        put ")"
        if main.vn_cluster4.isneq("") {
            put " cluster4(" /hidden main.vn_cluster4 ")"
        }
    }
END

PROGRAM oneclick_update
BEGIN
    put "journalone_update"
    stata hidden immediate
    if _rc {
        stopbox stop "更新失败；请检查网络或插件发布地址。"
    }
    else {
        stopbox note "更新完成。重新打开插件即可使用新版。"
        close
    }
END

PROGRAM command
BEGIN
    if main.ed_license.isneq("") {
        put "journalone_license, activate(" `"""' main.ed_license `"""' ")"
        stata hidden immediate
        if _rc {
            stopbox stop "授权密钥无效；请向插件发布者获取正确密钥。"
        }
        call main.ed_license.setvalue ""
    }
    put "journalone,"
    if main.ck_desc | main.vl_desc.isneq("") {
        if main.vl_desc.isneq("") {
            put " descvars("
            put main.vl_desc
            put ")"
        }
    }
    else {
        put " nodesc"
    }
    put " " /program baseline_model1_output
    put " " /program baseline_model2_output
    put " " /program baseline_model3_output
    put " " /program baseline_model4_output

    put " level("
    put main.cb_level
    put ")"

    if more.vn_treat.isneq("") {
        put " treat("
        put more.vn_treat
        put ")"
    }
    if more.vn_post.isneq("") {
        put " post("
        put more.vn_post
        put ")"
    }
    if main.vl_endog.isneq("") {
        put " endog("
        put main.vl_endog
        put ")"
    }
    if main.vl_instruments.isneq("") {
        put " instruments("
        put main.vl_instruments
        put ")"
    }

    if main.vl_alty.isneq("") {
        put " alty("
        put main.vl_alty
        put ")"
    }
    if main.vl_altx.isneq("") {
        put " altx("
        put main.vl_altx
        put ")"
    }
    if main.vl_addcontrols.isneq("") {
        put " addcontrols("
        put main.vl_addcontrols
        put ")"
    }
    if main.vl_addfe.isneq("") {
        put " addfe("
        put main.vl_addfe
        put ")"
    }
    if main.ed_lags.isneq("") {
        put " lags("
        put main.ed_lags
        put ")"
    }
    if main.ed_leads.isneq("") {
        put " leads("
        put main.ed_leads
        put ")"
    }
    if main.ed_subsample.isneq("") {
        put " subsample("
        put main.ed_subsample
        put ")"
    }
    if more.cb_altvce.isneq("不运行") {
        put " altvce("
        if more.cb_altvce.iseq("常规标准误") {
            put "conventional"
        }
        if more.cb_altvce.iseq("异方差稳健") {
            put "robust"
        }
        if more.cb_altvce.iseq("聚类稳健") {
            put "cluster"
        }
        put ")"
    }
    if more.vn_altcluster.isneq("") {
        put " altcluster("
        put more.vn_altcluster
        put ")"
    }

    if main.vl_mediators.isneq("") {
        put " mediators("
        put main.vl_mediators
        put ")"
    }
    if main.vl_moderators.isneq("") {
        put " moderators("
        put main.vl_moderators
        put ")"
    }
    if main.vn_group.isneq("") {
        put " group("
        put main.vn_group
        put ")"
    }

    if more.cb_sample.iseq("全体筛选样本") {
        put " descsample(full)"
    }
    if more.cb_report.iseq("生成DOCX") {
        put " reportmode(docx)"
    }
    if more.cb_report.iseq("生成并打开DOCX") {
        put " reportmode(docx_open)"
    }
    if more.ed_decimals.isneq("") {
        put " decimals("
        put more.ed_decimals
        put ")"
    }
    if more.cb_statistic.iseq("t值") {
        put " statistic(t)"
    }
    if more.cb_missing.iseq("已在预处理完成") {
        put " missingmode(preprocessed)"
    }
    if more.ck_ptrend {
        put " ptrend ptlevel("
        put more.cb_ptlevel
        put ")"
        if more.ed_ptbase.isneq("") {
            put " ptbase("
            put more.ed_ptbase
            put ")"
        }
    }
    if more.cb_psm_method.isneq("不运行") {
        put " psmmethod("
        if more.cb_psm_method.iseq("近邻匹配") {
            put "nearest"
        }
        if more.cb_psm_method.iseq("半径匹配") {
            put "radius"
        }
        if more.cb_psm_method.iseq("核匹配") {
            put "kernel"
        }
        put ")"
        if more.vl_psm_covars.isneq("") {
            put " psmcovars("
            put more.vl_psm_covars
            put ")"
        }
        if more.vn_psm_time.isneq("") {
            put " psmtime("
            put more.vn_psm_time
            put ")"
        }
        if more.ed_psmneighbor.isneq("") {
            put " psmneighbor("
            put more.ed_psmneighbor
            put ")"
        }
    }
    if more.vn_heckman_sel.isneq("") {
        put " heckmansel("
        put more.vn_heckman_sel
        put ")"
    }
    if more.vl_heckman_covars.isneq("") {
        put " heckmancovars("
        put more.vl_heckman_covars
        put ")"
    }
    if more.ck_heckman_fe & more.vn_heckman_sel.isneq("") {
        put " heckmanfe"
    }
    if more.cb_gmm_method.isneq("不运行") {
        put " gmmmethod("
        if more.cb_gmm_method.iseq("差分GMM") {
            put "difference"
        }
        if more.cb_gmm_method.iseq("系统GMM") {
            put "system"
        }
        put ")"
        if more.vl_gmm_extra.isneq("") {
            put " gmmextra("
            put more.vl_gmm_extra
            put ")"
        }
        if more.ed_gmm_lags.isneq("") {
            put " gmmlags("
            put more.ed_gmm_lags
            put ")"
        }
        if more.ck_gmm_twostep {
            put " gmmtwostep"
        }
    }
    if more.cb_dml_method.isneq("不运行") {
        put " dmlmethod("
        if more.cb_dml_method.iseq("部分线性DML") {
            put "partial"
        }
        if more.cb_dml_method.iseq("DML-IV") {
            put "iv"
        }
        put ")"
        if more.vl_dml_iv.isneq("") {
            put " dmlinstruments("
            put more.vl_dml_iv
            put ")"
        }
        if more.vl_dml_controls.isneq("") {
            put " dmlcontrols("
            put more.vl_dml_controls
            put ")"
        }
        if more.ed_dml_folds.isneq("") {
            put " dmlfolds("
            put more.ed_dml_folds
            put ")"
        }
    }
    if more.ed_group_bins.isneq("") {
        put " groupbins("
        put more.ed_group_bins
        put ")"
    }
    if more.ck_split_hetero {
        put " splithet"
    }
    if more.ck_group_test {
        put " grouptest"
    }
    if more.cb_med_method.iseq("不运行") {
        put " medmethod(none)"
    }
    if more.ck_split_med {
        put " splitmed"
    }
    if more.ck_mod_plot {
        put " modplot"
    }
    if more.cb_adjust.iseq("临时缩尾") {
        put " adjustmethod(winsor)"
        put " winsorlow("
        put more.ed_winsor_low
        put ") winsorhigh("
        put more.ed_winsor_high
        put ")"
    }
    if more.ed_pstar1.isneq("") {
        put " pstar1("
        put more.ed_pstar1
        put ")"
    }
    if more.ed_pstar2.isneq("") {
        put " pstar2("
        put more.ed_pstar2
        put ")"
    }
    if more.ed_pstar3.isneq("") {
        put " pstar3("
        put more.ed_pstar3
        put ")"
    }
    if more.ed_reps.isneq("") {
        put " reps("
        put more.ed_reps
        put ")"
    }

    if more.ed_outdir.isneq("") {
        put " outdir("
        put more.ed_outdir
        put ")"
    }
    if more.ed_prefix.isneq("") {
        put " prefix("
        put more.ed_prefix
        put ")"
    }
    if more.ed_seed.isneq("") {
        put " seed("
        put more.ed_seed
        put ")"
    }
END

