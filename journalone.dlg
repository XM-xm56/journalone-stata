    VARLIST vl_x3 135 @ 325 ., numeric fv ts allowcat tooltip("核心解释变量，可按需要填写多个")
    TEXT tx_if3 500 @ 100 ., label("样本条件：")
    EDIT ed_if3 605 @ 345 ., tooltip("例如 year>=2010 & year<=2025")
    TEXT tx_controls3 45 402 85 ., label("控制变量：")
    VARLIST vl_controls3 135 @ 325 ., numeric fv ts allowcat
    TEXT tx_absorb3 500 @ 100 ., label("固定效应：")
    VARLIST vl_absorb3 605 @ 345 ., tooltip("固定效应变量填写原名，不写i.前缀")
    TEXT tx_panel3 45 429 55 ., label("面板ID：")
    VARNAME vn_panel3 105 @ 160 .
    TEXT tx_time3 285 @ 75 ., label("时间变量：")
    VARNAME vn_time3 365 @ 160 ., numeric
    TEXT tx_cluster3 545 @ 85 ., label("聚类变量：")
    EDIT vn_cluster3 635 @ 150 ., tooltip("可填写单个聚类变量；HDFE模型也可填写交互聚类，如 group_id#time_id")
    CHECKBOX ck_timefe3 805 @ 170 ., label("加入时间固定效应") default(0)
    TEXT tx_note3 815 @ 160 ., label("")

    GROUPBOX gb4 30 455 960 126, label("模型 4")
    BUTTON bu_collapse4 920 250 55 ., label("折叠") onpush(program baseline_fold_all_dispatch)
    BUTTON bu_expand4 920 248 55 ., label("展开") onpush(program baseline_render_model4)
    TEXT tx_collapsed4 180 581 650 ., label("已折叠；内容保留并参与运行。")
    TEXT tx_model4 45 478 85 ., label("模型类型：")
    COMBOBOX cb_model4 135 @ 210 ., dropdownlist contents(model_list)
    TEXT tx_y4 365 @ 90 ., label("被解释变量：")
    VARNAME vn_y4 460 @ 210 ., numeric tooltip("被解释变量")
    TEXT tx_vce4 690 @ 65 ., label("标准误：")
    COMBOBOX cb_vce4 760 @ 190 ., dropdownlist contents(vce_list)
    TEXT tx_x4 45 505 85 ., label("核心解释变量：")
    VARLIST vl_x4 135 @ 325 ., numeric fv ts allowcat tooltip("核心解释变量，可按需要填写多个")
    TEXT tx_if4 500 @ 100 ., label("样本条件：")
    EDIT ed_if4 605 @ 345 ., tooltip("例如 year>=2010 & year<=2025")
    TEXT tx_controls4 45 532 85 ., label("控制变量：")
    VARLIST vl_controls4 135 @ 325 ., numeric fv ts allowcat
    TEXT tx_absorb4 500 @ 100 ., label("固定效应：")
    VARLIST vl_absorb4 605 @ 345 ., tooltip("固定效应变量填写原名，不写i.前缀")
    TEXT tx_panel4 45 559 55 ., label("面板ID：")
    VARNAME vn_panel4 105 @ 160 .
    TEXT tx_time4 285 @ 75 ., label("时间变量：")
    VARNAME vn_time4 365 @ 160 ., numeric
    TEXT tx_cluster4 545 @ 85 ., label("聚类变量：")
    EDIT vn_cluster4 635 @ 150 ., tooltip("可填写单个聚类变量；HDFE模型也可填写交互聚类，如 group_id#time_id")
    CHECKBOX ck_timefe4 805 @ 170 ., label("加入时间固定效应") default(0)
    TEXT tx_note4 815 @ 160 ., label("")

    GROUPBOX gb5 30 585 960 126, label("模型 5")
    BUTTON bu_collapse5 920 288 55 ., label("折叠") onpush(program baseline_fold_all_dispatch)
    BUTTON bu_expand5 920 286 55 ., label("展开") onpush(program baseline_render_model5)
    TEXT tx_collapsed5 180 613 650 ., label("已折叠；内容保留并参与运行。")
    TEXT tx_model5 45 608 85 ., label("模型类型：")
    COMBOBOX cb_model5 135 @ 210 ., dropdownlist contents(model_list)
    TEXT tx_y5 365 @ 90 ., label("被解释变量：")
    VARNAME vn_y5 460 @ 210 ., numeric tooltip("被解释变量")
    TEXT tx_vce5 690 @ 65 ., label("标准误：")
    COMBOBOX cb_vce5 760 @ 190 ., dropdownlist contents(vce_list)
    TEXT tx_x5 45 635 85 ., label("核心解释变量：")
    VARLIST vl_x5 135 @ 325 ., numeric fv ts allowcat tooltip("核心解释变量，可按需要填写多个")
    TEXT tx_if5 500 @ 100 ., label("样本条件：")
    EDIT ed_if5 605 @ 345 ., tooltip("例如 year>=2010 & year<=2025")
    TEXT tx_controls5 45 662 85 ., label("控制变量：")
    VARLIST vl_controls5 135 @ 325 ., numeric fv ts allowcat
    TEXT tx_absorb5 500 @ 100 ., label("固定效应：")
    VARLIST vl_absorb5 605 @ 345 ., tooltip("固定效应变量填写原名，不写i.前缀")
    TEXT tx_panel5 45 689 55 ., label("面板ID：")
    VARNAME vn_panel5 105 @ 160 .
    TEXT tx_time5 285 @ 75 ., label("时间变量：")
    VARNAME vn_time5 365 @ 160 ., numeric
    TEXT tx_cluster5 545 @ 85 ., label("聚类变量：")
    EDIT vn_cluster5 635 @ 150 ., tooltip("可填写单个聚类变量；HDFE模型也可填写交互聚类，如 group_id#time_id")
    CHECKBOX ck_timefe5 805 @ 170 ., label("加入时间固定效应") default(0)
    TEXT tx_note5 815 @ 160 ., label("")

    GROUPBOX gb6 30 715 960 126, label("模型 6")
    BUTTON bu_collapse6 920 326 55 ., label("折叠") onpush(program baseline_fold_all_dispatch)
    BUTTON bu_expand6 920 324 55 ., label("展开") onpush(program baseline_render_model6)
    TEXT tx_collapsed6 180 745 650 ., label("已折叠；内容保留并参与运行。")
    TEXT tx_model6 45 738 85 ., label("模型类型：")
    COMBOBOX cb_model6 135 @ 210 ., dropdownlist contents(model_list)
    TEXT tx_y6 365 @ 90 ., label("被解释变量：")
    VARNAME vn_y6 460 @ 210 ., numeric tooltip("被解释变量")
    TEXT tx_vce6 690 @ 65 ., label("标准误：")
    COMBOBOX cb_vce6 760 @ 190 ., dropdownlist contents(vce_list)
    TEXT tx_x6 45 765 85 ., label("核心解释变量：")
    VARLIST vl_x6 135 @ 325 ., numeric fv ts allowcat tooltip("核心解释变量，可按需要填写多个")
