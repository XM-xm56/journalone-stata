SCRIPT baseline_panel_expand
BEGIN
    main.tx_level.hide
    main.cb_level.hide
    main.gb_desc.hide
    main.ck_desc.hide
    main.tx_descvars.hide
    main.vl_desc.hide
    main.tx_desc_note.hide
    main.gb_base.hide
    main.tx_base_tab_note.hide
    main.bu_update.hide
    main.tx_license.setposition 300 43 45 .
    main.ed_license.setposition 345 35 145 .
    main.bu_base_open.hide
    main.tx_base_summary1.hide
    main.tx_base_summary2.hide
    main.tx_base_summary3.hide
    script empirical_modules_hide
    main.gb_base_editor.show
    main.tx_instruction.show
    main.bu_add.show
    main.bu_remove.show
    main.bu_base_close.show
    program baseline_panel_expand_dispatch
END

PROGRAM baseline_panel_expand_dispatch
BEGIN
    if baseline_model_count.iseq(1) {
        call script baseline_count1
        call main.bu_add.enable
        call main.bu_remove.disable
        call program baseline_visibility_dispatch
    }
    else {
        if baseline_model_count.iseq(2) {
            call script baseline_count2
            call main.bu_add.enable
            call main.bu_remove.enable
            call program baseline_visibility_dispatch
        }
        else {
            if baseline_model_count.iseq(3) {
                call script baseline_count3
                call main.bu_add.enable
                call main.bu_remove.enable
                call program baseline_visibility_dispatch
            }
            else {
                call script baseline_count4
                call main.bu_add.disable
                call main.bu_remove.enable
                call program baseline_visibility_dispatch
            }
        }
    }
END

SCRIPT baseline_panel_collapse
BEGIN
    main.tx_level.show
    main.cb_level.show
    main.tx_license.setposition 600 10 45 .
    main.ed_license.setposition 650 8 160 .
    main.gb_desc.show
    main.ck_desc.show
    main.tx_descvars.show
    main.vl_desc.show
    main.tx_desc_note.show
    main.gb_base_editor.hide
    main.tx_instruction.hide
    main.tx_count1.hide
    main.tx_count2.hide
    main.tx_count3.hide
    main.tx_count4.hide
    main.bu_add.hide
    main.bu_remove.hide
    main.bu_base_close.hide
    script baseline_model1_hide
    script baseline_model2_hide
    script baseline_model3_hide
    script baseline_model4_hide
    main.gb_base.show
    main.tx_base_tab_note.show
    main.bu_update.show
    main.bu_base_open.show
    main.tx_base_summary1.show
    main.tx_base_summary2.show
    main.tx_base_summary3.show
    script empirical_modules_show
END

SCRIPT baseline_add_model
BEGIN
    program baseline_add_model_dispatch
END

PROGRAM baseline_add_model_dispatch
BEGIN
    if baseline_model_count.iseq(1) {
        call baseline_model_count.setvalue 2
        call script baseline_count2
        call program baseline_visibility_dispatch
        call main.bu_remove.enable
    }
    else {
        if baseline_model_count.iseq(2) {
            call baseline_model_count.setvalue 3
            call script baseline_count3
            call program baseline_visibility_dispatch
        }
        else {
            if baseline_model_count.iseq(3) {
                call baseline_model_count.setvalue 4
                call script baseline_count4
                call program baseline_visibility_dispatch
                call main.bu_add.disable
            }
        }
    }
END

SCRIPT baseline_remove_model
BEGIN
    program baseline_remove_model_dispatch
END

PROGRAM baseline_remove_model_dispatch
BEGIN
    if baseline_model_count.iseq(4) {
        call script baseline_model4_remove
        call baseline_model_count.setvalue 3
        call script baseline_count3
        call program baseline_visibility_dispatch
        call main.bu_add.enable
    }
    else {
        if baseline_model_count.iseq(3) {
            call script baseline_model3_remove
            call baseline_model_count.setvalue 2
            call script baseline_count2
            call program baseline_visibility_dispatch
        }
        else {
            if baseline_model_count.iseq(2) {
                call script baseline_model2_remove
                call baseline_model_count.setvalue 1
                call script baseline_count1
                call program baseline_visibility_dispatch
                call main.bu_remove.disable
            }
        }
    }
END

