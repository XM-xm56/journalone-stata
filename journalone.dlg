PROGRAM license_gate_dispatch
BEGIN
    if license_gate_state.iseq(1) {
        call script license_gate_unlock
    }
    else {
        call script license_gate_lock
    }
END

PROGRAM activate_license
BEGIN
    if main.ed_license.iseq("") {
        put "_journalone_require_license"
        stata hidden immediate
        if _rc {
            stopbox stop "尚未检测到有效授权；请输入发布者提供的密钥。"
        }
        call script license_gate_unlock
        stopbox note "已检测到本机有效授权；实证分析功能已解锁。"
        exit
    }
    put "journalone_license, activate(" `""""' main.ed_license `""""' ")"
    stata hidden immediate
    if _rc {
        call script license_gate_lock
        stopbox stop "授权密钥无效；分析功能仍处于锁定状态。"
    }
    call main.ed_license.setvalue ""
    call script license_gate_unlock
    stopbox note "授权成功；实证分析功能已解锁。"
END

PROGRAM oneclick_update
BEGIN
    put "journalone_update"
    stata hidden immediate
    if _rc {
        stopbox stop "更新失败；请检查网络或插件发布地址。"
    }
    else {
        stopbox note "更新完成。重新打开插件即可使用新版。"
        close
    }
END

PROGRAM command
BEGIN
    if main.ed_license.isneq("") {
        put "journalone_license, activate(" `"""' main.ed_license `"""' ")"
        stata hidden immediate
        if _rc {
            stopbox stop "授权密钥无效；请向插件发布者获取正确密钥。"
        }
        call main.ed_license.setvalue ""
        call script license_gate_unlock
    }
    put "_journalone_require_license"
    stata hidden immediate
    if _rc {
        call script license_gate_lock
        stopbox stop "JournalOne 尚未激活；请输入有效密钥并点击“激活并解锁”。"
    }
    put "journalone,"
    if main.ck_desc | main.vl_desc.isneq("") {
        if main.vl_desc.isneq("") {
            put " descvars("
            put main.vl_desc
            put ")"
        }
    }
    else {
        put " nodesc"
    }
    if main.vl_corr.isneq("") {
        put " corrvars("
        put main.vl_corr
        put ")"
    }
    if main.ck_vif {
        put " vifcheck"
    }
    if main.ck_paneltests {
        put " paneltests"
    }
    if main.ck_ivtests {
        put " ivtests"
    }
    if main.ck_ovb {
        put " ovbtest"
    }
    put " " /program baseline_model1_output
    put " " /program baseline_model2_output
    put " " /program baseline_model3_output
    put " " /program baseline_model4_output
    put " " /program baseline_model5_output
    put " " /program baseline_model6_output

    put " level("
    put main.cb_level
    put ")"

    if more.vn_treat.isneq("") {
        put " treat("
        put more.vn_treat
        put ")"
    }
    if more.vn_post.isneq("") {
        put " post("
        put more.vn_post
        put ")"
    }
    if main.vl_endog.isneq("") {
        put " endog("
        put main.vl_endog
        put ")"
    }
    if main.vl_instruments.isneq("") {
        put " instruments("
        put main.vl_instruments
        put ")"
    }
    if main.ed_ivcluster.isneq("") {
        put " ivcluster("
        put main.ed_ivcluster
        put ")"
    }

    if main.vl_alty.isneq("") {
        put " alty("
        put main.vl_alty
        put ")"
    }
    if main.vl_altx.isneq("") {
        put " altx("
        put main.vl_altx
        put ")"
    }
    if main.vl_addcontrols.isneq("") {
        put " addcontrols("
        put main.vl_addcontrols
        put ")"
    }
    if main.vl_addfe.isneq("") {
        put " addfe("
        put main.vl_addfe
        put ")"
    }
    if main.ed_lags.isneq("") {
        put " lags("
        put main.ed_lags
        put ")"
    }
    if main.ed_leads.isneq("") {
        put " leads("
        put main.ed_leads
        put ")"
    }
    if main.ed_subsample.isneq("") {
        put " subsample("
        put main.ed_subsample
        put ")"
    }
    if main.ed_customspecs.isneq("") {
        put " customspecs(" `""' main.ed_customspecs `""' ")"
    }
    if more.cb_altvce.isneq("不运行") {
        put " altvce("
        if more.cb_altvce.iseq("常规标准误") {
            put "conventional"
        }
        if more.cb_altvce.iseq("异方差稳健") {
            put "robust"
        }
        if more.cb_altvce.iseq("聚类稳健") {
            put "cluster"
        }
        put ")"
    }
    if more.vn_altcluster.isneq("") {
        put " altcluster("
        put more.vn_altcluster
        put ")"
    }

    if main.vl_mediators.isneq("") {
        put " mediators("
        put main.vl_mediators
        put ")"
    }
    if main.vl_moderators.isneq("") {
        put " moderators("
        put main.vl_moderators
        put ")"
    }
    if more.ed_medclusters.isneq("") {
        put " medclusters(" `""' more.ed_medclusters `""' ")"
    }
    if more.ed_modinteractions.isneq("") {
        put " modinteractions(" `""' more.ed_modinteractions `""' ")"
    }
    if main.vn_group.isneq("") {
        put " group("
        put main.vn_group
        put ")"
    }

    if more.cb_sample.iseq("全体筛选样本") {
        put " descsample(full)"
    }
    if more.ed_decimals.isneq("") {
        put " decimals("
        put more.ed_decimals
        put ")"
    }
    if more.cb_statistic.iseq("t值") {
        put " statistic(t)"
    }
    if more.cb_missing.iseq("已在预处理完成") {
        put " missingmode(preprocessed)"
    }
    if more.ck_ptrend {
        put " ptrend ptlevel("
        put more.cb_ptlevel
        put ")"
        if more.ed_ptbase.isneq("") {
            put " ptbase("
            put more.ed_ptbase
            put ")"
        }
    }
    if more.cb_psm_method.isneq("不运行") {
        if more.cb_psm_method.iseq("近邻匹配") {
            put " psmmethod(nearest)"
        }
        if more.cb_psm_method.iseq("半径匹配") {
            put " psmmethod(radius)"
        }
        if more.cb_psm_method.iseq("核匹配") {
            put " psmmethod(kernel)"
        }
        if more.vl_psm_covars.isneq("") {
            put " psmcovars("
            put more.vl_psm_covars
            put ")"
        }
        if more.vn_psm_time.isneq("") {
            put " psmtime("
            put more.vn_psm_time
            put ")"
        }
        if !more.cb_psm_method.iseq("预生成权重") & more.ed_psmneighbor.isneq("") {
            put " psmneighbor("
            put more.ed_psmneighbor
            put ")"
        }
        if more.vn_psm_weight.isneq("") {
            put " psmweight("
            put more.vn_psm_weight
            put ")"
        }
    }
    if more.vn_heckman_sel.isneq("") {
        put " heckmansel("
        put more.vn_heckman_sel
        put ")"
    }
    if more.vl_heckman_covars.isneq("") {
        put " heckmancovars("
        put more.vl_heckman_covars
        put ")"
    }
    if more.vn_heckman_imr.isneq("") {
        put " heckmanimr("
        put more.vn_heckman_imr
        put ")"
    }
    if more.vl_heckman_outcovars.isneq("") {
        put " heckmanoutcovars("
        put more.vl_heckman_outcovars
        put ")"
    }
    if more.ck_heckman_fe & more.vn_heckman_sel.isneq("") {
        put " heckmanfe"
    }
    if more.cb_gmm_method.isneq("不运行") {
        put " gmmmethod("
        if more.cb_gmm_method.iseq("差分GMM") {
            put "difference"
        }
        if more.cb_gmm_method.iseq("系统GMM") {
            put "system"
        }
        put ")"
        if more.vl_gmm_extra.isneq("") {
            put " gmmextra("
            put more.vl_gmm_extra
            put ")"
        }
        if more.ed_gmm_lags.isneq("") {
            put " gmmlags("
            put more.ed_gmm_lags
            put ")"
        }
        if more.ck_gmm_twostep {
            put " gmmtwostep"
        }
    }
    if more.cb_dml_method.isneq("不运行") {
        put " dmlmethod("
        if more.cb_dml_method.iseq("部分线性DML") {
            put "partial"
        }
        if more.cb_dml_method.iseq("DML-IV") {
            put "iv"
        }
        put ")"
        if more.vl_dml_iv.isneq("") {
            put " dmlinstruments("
            put more.vl_dml_iv
            put ")"
        }
        if more.vl_dml_controls.isneq("") {
            put " dmlcontrols("
            put more.vl_dml_controls
            put ")"
        }
        if more.ed_dml_folds.isneq("") {
            put " dmlfolds("
            put more.ed_dml_folds
            put ")"
        }
    }
    if more.ed_group_bins.isneq("") {
        put " groupbins("
        put more.ed_group_bins
        put ")"
    }
    if more.ck_split_hetero {
        put " splithet"
    }
    if more.ck_group_test {
        put " grouptest"
    }
    if more.cb_med_method.iseq("不运行") {
        put " medmethod(none)"
    }
    if more.ck_split_med {
        put " splitmed"
    }
    if more.ck_mod_plot {
        put " modplot"
    }
    if more.cb_adjust.iseq("临时缩尾") {
        put " adjustmethod(winsor)"
        put " winsorlow("
        put more.ed_winsor_low
        put ") winsorhigh("
        put more.ed_winsor_high
        put ")"
    }
    if more.ed_pstar1.isneq("") {
        put " pstar1("
        put more.ed_pstar1
        put ")"
    }
    if more.ed_pstar2.isneq("") {
        put " pstar2("
        put more.ed_pstar2
        put ")"
    }
    if more.ed_pstar3.isneq("") {
        put " pstar3("
        put more.ed_pstar3
        put ")"
    }
    if more.ed_reps.isneq("") {
        put " reps("
        put more.ed_reps
        put ")"
    }

    if more.ed_outdir.isneq("") {
        put " outdir("
        put more.ed_outdir
        put ")"
    }
    if more.ed_prefix.isneq("") {
        put " prefix("
        put more.ed_prefix
        put ")"
    }
    if more.ed_seed.isneq("") {
        put " seed("
        put more.ed_seed
        put ")"
    }
END

