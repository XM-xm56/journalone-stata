SCRIPT baseline_count1
BEGIN
    main.tx_count1.show
    main.tx_count2.hide
    main.tx_count3.hide
    main.tx_count4.hide
END

SCRIPT baseline_count2
BEGIN
    main.tx_count1.hide
    main.tx_count2.show
    main.tx_count3.hide
    main.tx_count4.hide
END

SCRIPT baseline_count3
BEGIN
    main.tx_count1.hide
    main.tx_count2.hide
    main.tx_count3.show
    main.tx_count4.hide
END

SCRIPT baseline_count4
BEGIN
    main.tx_count1.hide
    main.tx_count2.hide
    main.tx_count3.hide
    main.tx_count4.show
END

SCRIPT baseline_model1_hide
BEGIN
    script baseline_model1_collapse
    main.gb1.hide
    main.bu_expand1.hide
    main.tx_collapsed1.hide
END

SCRIPT baseline_model2_hide
BEGIN
    script baseline_model2_collapse
    main.gb2.hide
    main.bu_expand2.hide
    main.tx_collapsed2.hide
END

SCRIPT baseline_model3_hide
BEGIN
    script baseline_model3_collapse
    main.gb3.hide
    main.bu_expand3.hide
    main.tx_collapsed3.hide
END

SCRIPT baseline_model4_hide
BEGIN
    script baseline_model4_collapse
    main.gb4.hide
    main.bu_expand4.hide
    main.tx_collapsed4.hide
END

SCRIPT baseline_layout_all_collapsed
BEGIN
    main.gb1.setposition 30 65 960 32
