PROGRAM baseline_model1_output
BEGIN
    if main.vn_y1.isneq("") {
        put "model("
        if main.cb_model1.iseq("普通最小二乘 OLS") {
            put "ols"
        }
        if main.cb_model1.iseq("高维固定效应 HDFE") {
            put "hdfe"
        }
        if main.cb_model1.iseq("面板固定效应 FE") {
            put "fe"
        }
        if main.cb_model1.iseq("面板随机效应 RE") {
            put "re"
        }
        if main.cb_model1.iseq("简单双重差分 DID") {
            put "did"
        }
        if main.cb_model1.iseq("两阶段最小二乘 IV") {
            put "iv"
        }
        put ") depvar(" /hidden main.vn_y1 ")"
        if main.vl_x1.isneq("") {
            put " indepvars(" /hidden main.vl_x1 ")"
        }
        if main.vl_controls1.isneq("") {
            put " controls(" /hidden main.vl_controls1 ")"
        }
        if main.vn_panel1.isneq("") {
            put " panel(" /hidden main.vn_panel1 ")"
        }
        if main.vn_time1.isneq("") {
            put " time(" /hidden main.vn_time1 ")"
        }
        if main.vl_absorb1.isneq("") {
            put " absorb(" /hidden main.vl_absorb1 ")"
        }
        if main.ck_timefe1 & main.vn_time1.isneq("") {
            put " timefe"
        }
        if main.ed_if1.isneq("") {
            put " ifcond(" /hidden main.ed_if1 ")"
        }
        put " vcetype("
        if main.cb_vce1.iseq("常规标准误") {
            put "conventional"
        }
        if main.cb_vce1.iseq("异方差稳健") {
            put "robust"
        }
        if main.cb_vce1.iseq("聚类稳健") {
            put "cluster"
        }
        put ")"
        if main.vn_cluster1.isneq("") {
            put " cluster(" /hidden main.vn_cluster1 ")"
        }
    }
END

